{
  "name": "reditor-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion studio untuk reditor (NetHunter / arm64 friendly)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "sync": "python3 scripts/sync_timeline.py --manifest manifest.json --transcript transcript.json",
    "render:full": "remotion render src/index.ts MainStory out/main_16x9.mp4",
    "render:vertical": "remotion render src/index.ts ShortVertical out/short_9x16.mp4",
    "render:short": "remotion render src/index.ts HighlightVertical out/highlight_9x16.mp4",
    "still": "remotion still src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/media-utils": "4.0.540",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
